[sub_resource type="Shader" id="Shader_ink"]
code = "shader_type canvas_item;
// 冥府书记员原图的刻线是金色的；美术规范：黑釉剪影 + 象牙刻线，金色只给神性标志和火。
// 按亮度把画重新上色：暗处 = 黑釉，亮处（刻线、卷轴）= 象牙。
uniform vec4 ink : source_color = vec4(0.0706, 0.0471, 0.0392, 1.0);
uniform vec4 ivory : source_color = vec4(0.918, 0.859, 0.722, 1.0);
void fragment() {
	vec4 c = texture(TEXTURE, UV);
	float l = dot(c.rgb, vec3(0.299, 0.587, 0.114));
	COLOR = vec4(mix(ink.rgb, ivory.rgb, smoothstep(0.14, 0.5, l)), c.a * COLOR.a);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_ink"]
shader = SubResource("Shader_ink")
shader_parameter/ink = Color(0.0706, 0.0471, 0.0392, 1)
shader_parameter/ivory = Color(0.918, 0.859, 0.722, 1)

